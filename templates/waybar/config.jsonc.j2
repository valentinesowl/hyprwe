// waybar/config.jsonc — GENERATED by `hwe theme apply` from "{{ name }}".
// Workspaces stay left, clock centred, quiet glyph-only indicators right.
// Exact readings and mouse actions live in tooltips, not permanently on the bar.
{
    "layer": "top",
    "position": "top",
    "height": {{ params.bar_height }},
    "spacing": 4,
    "margin-top": {{ params.bar_gap if params.bar_float else 0 }},
    "margin-left": {{ params.bar_gap_x if params.bar_float else 0 }},
    "margin-right": {{ params.bar_gap_x if params.bar_float else 0 }},

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/cpu", "custom/memory", "custom/temp", "custom/record", "pulseaudio", "backlight", "battery", "hyprland/language", "custom/sunset"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "clock": {
        "format": "{:%d.%m  %H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "hyprland/language": {
        "format": "{short}",
        "format-en": "US",
        "format-ru": "RU",
        "tooltip-format": "Keyboard: {long}\nLeft click / Super+Space: next layout",
        "on-click": "hyprctl switchxkblayout current next"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc} — {volume}%\nScroll: volume · Left click: mixer · Right click: mute",
        "on-click": "pavucontrol",
        "on-click-right": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    // The module hides itself on machines without a backlight device.
    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness: {percent}%\nScroll: brightness",
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower"
    },

    // Network and VPN controls live in the existing nm-applet tray icon.
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}",
        "format-warning": "! {icon}",
        "format-critical": "!! {icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Battery: {capacity}% — {timeTo} ({power}W)"
    },

    // Quiet glyphs; exact percentages, sparklines and actions stay in tooltips.
    "custom/cpu": {
        "format": "{icon}",
        "format-icons": ["󰾆", "󰾅", "󰓅"],
        "return-type": "json",
        "interval": 2,
        "exec": "python3 {{ scripts_dir }}/wbstat.py cpu",
        "on-click": "kitty -e btop"
    },

    "custom/memory": {
        "format": "{icon}",
        "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
        "return-type": "json",
        "interval": 2,
        "exec": "python3 {{ scripts_dir }}/wbstat.py mem",
        "on-click": "kitty -e btop"
    },

    // wbstat discovers the sensor by chip name, not unstable hwmon paths. It
    // emits visible text only near warning/critical; cooler temperatures stay quiet.
    "custom/temp": {
        "format": "{}",
        "return-type": "json",
        "interval": 4,
        "exec": "python3 {{ scripts_dir }}/wbstat.py temp",
        "exec-if": "python3 {{ scripts_dir }}/wbstat.py temp --probe",
        "on-click": "kitty -e btop"
    },

    "custom/record": {
        "format": "{}",
        "interval": 1,
        "exec": "pgrep -x wf-recorder >/dev/null && echo '● REC' || echo ''",
        "on-click": "hwe record",
        "tooltip-format": "Recording · Left click: stop and save"
    },

    "custom/sunset": {
        "format": "{}",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "exec": "hwe sunset status --waybar",
        "on-click": "hwe sunset"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
