/* rofi/theme.rasi — GENERATED by `hwe theme apply` from "{{ name }}".
   A 4 × 3 gallery of graphic identity cards. Up to twelve cards fit at
   1366×768; additional user themes scroll. Names are part of the artwork. */

* {
    bg-dark:      {{ sem.bg_dark }};
    bg-normal:    {{ sem.bg_normal }};
    bg-light:     {{ sem.bg_light }};
    fg-dim:       {{ sem.fg_dim }};
    fg-bright:    {{ sem.fg_bright }};
    accent:       {{ sem.accent }};
    on-accent:    {{ sem.on_accent }};
    accent-soft:  {{ sem.accent_soft }};
    transparent:  #00000000;

    font: "{{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }} {{ font.launcher | round | int }}";
    background-color: @transparent;
    text-color: @fg-bright;
}

window {
    location:         center;
    anchor:           center;
    width:            876px;
    border:           0;
    border-radius:    {{ params.rounding + 6 }}px;
    background-color: {{ sem.bg_dark | hexa(0.96) }};
}

mainbox {
    spacing:          10px;
    children:         [ "inputbar", "listview", "message" ];
    background-color: @transparent;
    padding:          20px;
}

message {
    padding:          2px 6px 0 6px;
    background-color: @transparent;
}

textbox {
    text-color:       @fg-dim;
    background-color: @transparent;
    horizontal-align: 0.5;
}

inputbar {
    padding:          2px 6px 10px 6px;
    spacing:          8px;
    background-color: @transparent;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @accent;
    background-color: @transparent;
}

entry {
    placeholder:      "Filter themes…";
    placeholder-color: @fg-dim;
    background-color: @transparent;
}

listview {
    columns:          4;
    lines:            3;
    fixed-height:     false;
    spacing:          12px;
    scrollbar:        true;
    background-color: @transparent;
    dynamic:          true;
}

element {
    padding:          4px;
    border:           1px;
    border-color:     @transparent;
    border-radius:    12px;
    background-color: @transparent;
    text-color:       @fg-bright;
    cursor:           pointer;
    children:         [ "element-icon" ];
}

element selected.normal {
    background-color: @transparent;
    border-color:     @accent;
    text-color:       @fg-bright;
}

element-icon {
    size:             184px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: @transparent;
    cursor:           inherit;
}
