/* rofi/center.rasi — GENERATED by `hwe theme apply` from "{{ name }}".
   The hyprwe command center: one quiet, numbered index over the workstation's
   own workflows. Reports and secondary menus retain the same visual grammar. */

* {
    bg-dark:      {{ sem.bg_dark }};
    bg-normal:    {{ sem.bg_normal }};
    bg-light:     {{ sem.bg_light }};
    fg-dim:       {{ sem.fg_dim }};
    fg-bright:    {{ sem.fg_bright }};
    accent:       {{ sem.accent }};
    accent-soft:  {{ sem.accent_soft }};
    on-accent:    {{ sem.on_accent }};
    urgent:       {{ sem.urgent }};
    transparent:  #00000000;

    font: "{{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }} {{ font.launcher | round | int }}";
    background-color: @transparent;
    text-color: @fg-bright;
}

window {
    location:         center;
    anchor:           center;
    width:            {{ ui.width }}px;
    border:           {{ ui.border }}px;
    border-color:     @accent-soft;
    border-radius:    {{ ui.radius }}px;
    background-color: {{ sem.bg_dark | hexa(0.98) }};
}

mainbox {
    children:         [ "message", "inputbar", "listview" ];
    spacing:          {{ ui.gap }}px;
    padding:          {{ ui.padding }}px;
    background-color: @transparent;
}

message {
    padding:          0 4px 6px 4px;
    background-color: @transparent;
}

textbox {
    font: "{{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }} {{ ui.meta }}";
    text-color:       @fg-dim;
    background-color: @transparent;
    horizontal-align: 0.0;
}

inputbar {
    children:         [ "prompt", "entry" ];
    spacing:          10px;
    padding:          12px 14px;
    border:           {{ ui.border }}px;
    border-color:     @bg-light;
    border-radius:    {{ ui.inner_radius }}px;
    background-color: @bg-normal;
}

prompt {
    font: "{{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }} {{ ui.title }}";
    text-color:       @accent;
    background-color: @transparent;
}

entry {
    placeholder:      "Type to filter · Esc to close";
    placeholder-color: @fg-dim;
    text-color:       @fg-bright;
    background-color: @transparent;
    cursor:           text;
}

listview {
    columns:          1;
    lines:            7;
    fixed-height:     false;
    dynamic:          true;
    cycle:            true;
    scrollbar:        false;
    spacing:          {{ ui.row_gap }}px;
    background-color: @transparent;
}

element {
    padding:          {{ ui.row_padding }}px 15px;
    spacing:          12px;
    border:           {{ ui.border }}px;
    border-color:     @transparent;
    border-radius:    {{ ui.inner_radius }}px;
    background-color: @transparent;
    text-color:       @fg-bright;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @transparent;
    text-color:       @fg-bright;
}

element selected.normal {
    border-color:     @accent;
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
    background-color: @transparent;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    background-color: @transparent;
    text-color:       inherit;
    highlight:        bold;
    cursor:           inherit;
}
