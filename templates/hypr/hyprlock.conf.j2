# hyprlock.conf — GENERATED by `hwe theme apply` from the active theme's [sem].
# Do NOT edit; edit templates/hypr/hyprlock.conf.j2 or the theme's roles instead.

background {
    monitor =
    # $HOME, NOT ~ — hyprlang expands env vars but not a leading ~.
    path = $HOME/.config/hypr/assets/current.lock.wall
    blur_passes = {{ params.blur_passes }}
    blur_size = {{ params.blur_size }}
    color = {{ sem.bg_normal|rgb }}
}

# Explicit scheme-aware scrim: labels never depend on wallpaper brightness.
shape {
    monitor =
    size = 100%, 100%
    color = {{ sem.bg_dark|rgba('f0') }}
    position = 0, 0
    halign = center
    valign = center
    zindex = 0
}

general {
    hide_cursor = true
}

input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2
    dots_size = 0.28
    dots_spacing = 0.32
    dots_center = true
    rounding = {{ params.rounding }}
    outer_color = {{ sem.accent|rgb }}
    inner_color = {{ sem.bg_light|rgb }}
    font_color = {{ sem.fg_bright|rgb }}
    font_family = {{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }}
    placeholder_text = <span foreground="##{{ sem.fg_dim|noh }}">Enter password…</span>
    fail_color = {{ sem.urgent|rgb }}
    fail_text = <span foreground="##{{ sem.urgent|noh }}">$FAIL ($ATTEMPTS)</span>
    capslock_color = {{ sem.orange|rgb }}
    numlock_color = {{ sem.blue|rgb }}
    bothlock_color = {{ sem.yellow|rgb }}
    position = 0, -40
    halign = center
    valign = center
    zindex = 1
}

label {
    monitor =
    text = $LAYOUT[US,RU]
    font_size = 14
    font_family = {{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }}
    color = {{ sem.fg_normal|rgb }}
    position = 0, -104
    halign = center
    valign = center
    zindex = 1
}

# Empty while Caps Lock is off; hyprctl reads the compositor's live keyboard state.
label {
    monitor =
    text = cmd[update:500] python3 {{ scripts_dir }}/lockstate.py
    font_size = 14
    font_family = {{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }}
    color = {{ sem.fg_bright|rgb }}
    position = 0, -132
    halign = center
    valign = center
    zindex = 1
}

label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    font_size = 96
    font_family = {{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }}
    color = {{ sem.fg_bright|rgb }}
    position = 0, 160
    halign = center
    valign = center
    zindex = 1
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    font_size = 20
    font_family = {{ font.family }}, {{ font.fallback_family }}, {{ font.icon_family }}
    color = {{ sem.fg_normal|rgb }}
    position = 0, 60
    halign = center
    valign = center
    zindex = 1
}
