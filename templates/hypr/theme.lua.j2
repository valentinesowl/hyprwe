-- hypr/theme.lua — GENERATED by `hwe theme` from {{ name | lua }}. DO NOT EDIT.
-- Loaded after appearance.lua; generated theme values override its baseline.

hl.config({
    general = {
        col = {
            active_border = {
                colors = {{ params.border_gradient | map('rgba') | list | lua }},
                angle = {{ params.border_angle | lua }},
            },
            inactive_border = { colors = { {{ params.border_inactive | rgba | lua }} } },
        },
        border_size = {{ params.border_size | lua }},
        gaps_in = {{ params.gaps_in | lua }},
        gaps_out = {{ params.gaps_out | lua }},
    },
    decoration = {
        rounding = {{ params.rounding | lua }},
        blur = {
            size = {{ params.blur_size | lua }},
            passes = {{ params.blur_passes | lua }},
        },
    },
    animations = { enabled = {{ (params.anim is not none) | lua }} },
})

hl.window_rule({
    match = { class = ".*" },
    opacity = {{ (params.active_opacity ~ " " ~ params.inactive_opacity ~ " 1.0") | lua }},
})

{% if params.anim %}
hl.animation({ leaf = "windows", enabled = true, speed = {{ params.anim.windows | lua }}, bezier = "wind", style = "slide" })
hl.animation({ leaf = "windowsIn", enabled = true, speed = {{ params.anim.windowsIn | lua }}, bezier = "overshot", style = "slide" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = {{ params.anim.windowsOut | lua }}, bezier = "smoothOut", style = "slide" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = {{ params.anim.windowsMove | lua }}, bezier = "wind", style = "slide" })
hl.animation({ leaf = "border", enabled = true, speed = {{ params.anim.border | lua }}, bezier = "default" })
hl.animation({ leaf = "fade", enabled = true, speed = {{ params.anim.fade | lua }}, bezier = "smoothIn" })
hl.animation({ leaf = "workspaces", enabled = true, speed = {{ params.anim.workspaces | lua }}, bezier = "wind" })
{% if params.border_animate %}
hl.animation({ leaf = "borderangle", enabled = true, speed = {{ params.border_animate | lua }}, bezier = "linear", style = "loop" })
{% endif %}
{% endif %}
